#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
    retro-tap;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    combos {
        compatible = "zmk,combos";

        lang_kana {
            bindings = <&kp LC(J)>;
            key-positions = <16 17>;
        };

        change_lang {
            bindings = <&kp LG(SPACE)>;
            key-positions = <13 12>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 25>;
        };

        reset_R {
            bindings = <&bootloader>;
            key-positions = <15 19>;
        };

        reset_L {
            bindings = <&bootloader>;
            key-positions = <10 14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp L  &kp U        &kp F            &kp MINUS        &kp K           &kp W        &kp R  &kp Y  &kp P
&kp E  &kp I  &kp A        &kp O            &kp COMMA        &kp G           &kp T        &kp N  &kp S  &lt 5 H
&kp Z  &kp X  &kp C        &kp V            &kp LSHIFT       &mt RSHIFT Z    &kp D        &kp M  &kp J  &kp B
              &lt 6 TILDE  &lt 1 BACKSPACE  &mt LCTRL TAB    &mt RSHIFT RET  &lt 2 SPACE
            >;
        };

        math {
            bindings = <
&none         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp TILDE     &kp CARET       &kp LESS_THAN    &kp EQUAL     &kp GREATER_THAN  &kp PERCENT
&kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD    &kp UNDERSCORE  &kp PLUS         &kp MINUS     &kp ASTERISK      &kp SLASH
&kp DOLLAR    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans        &trans          &kp EXCLAMATION  &kp QUESTION  &kp COLON         &kp SEMICOLON
                            &trans        &none         &trans        &trans          &lt 3 SPACE
            >;
        };

        navi {
            bindings = <
&kp AT         &kp LEFT_BRACKET      &kp DOUBLE_QUOTES  &kp RIGHT_BRACKET      &kp AMPERSAND    &kp ESCAPE  &none           &none           &none         &kp LG(LS(S))
&kp HASH       &kp LEFT_PARENTHESIS  &kp SINGLE_QUOTE   &kp RIGHT_PARENTHESIS  &kp PIPE         &none       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&kp BACKSLASH  &kp LEFT_BRACE        &kp GRAVE          &kp RIGHT_BRACE        &trans           &trans      &none           &none           &none         &none
                                     &trans             &lt 3 BACKSPACE        &trans           &trans      &none
            >;
        };

        system {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none    &kp ESCAPE      &kp INSERT  &kp HOME      &kp PAGE_UP    &none
&kp F5  &kp F6   &kp F7   &kp F8   &none    &none           &kp DELETE  &kp END       &kp PAGE_DOWN  &none
&kp F9  &kp F10  &kp F11  &kp F12  &none    &bt BT_CLR_ALL  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2
                 &none    &none    &none    &none           &none
            >;
        };

        mouse {
            bindings = <
&kp Q  &kp L  &kp U        &kp F            &kp MINUS        &kp K             &kp W        &kp R     &kp Y  &kp P
&kp E  &kp I  &kp A        &kp O            &kp COMMA        &mkp MB3          &mkp MB1     &mkp MB2  &kp S  &lt 5 H
&kp Z  &kp X  &kp C        &kp V            &kp LSHFT        &mt RSHIFT Z      &kp D        &kp M     &kp J  &kp B
              &lt 6 TILDE  &lt 1 BACKSPACE  &mt LCTRL TAB    &mt RSHIFT ENTER  &lt 2 SPACE
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans    &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&kp LS(LC(T))  &kp LC(PAGE_UP)     &kp LC(T)  &kp LC(PAGE_DOWN)    &kp LC(W)    &trans  &trans  &trans  &trans  &trans
&trans         &kp LA(LEFT_ARROW)  &trans     &kp LA(RIGHT_ARROW)  &trans       &trans  &trans  &trans  &trans  &trans
&trans         &trans              &trans     &trans               &trans       &trans  &trans  &trans  &trans  &trans
                                   &trans     &trans               &trans       &trans  &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
